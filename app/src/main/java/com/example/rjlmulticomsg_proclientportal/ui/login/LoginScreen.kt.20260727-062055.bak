/**
 * Live interactive login matching the design PDF:
 * night-gate scene background + real Multicom logo, neon CLIENT PORTAL,
 * working email/password, remember me, forgot password, SIGN IN, Google.
 */
@Composable
fun LoginScreen(
    repository: PortalRepository,
    onLoggedIn: () -> Unit
) {
    val scope = rememberCoroutineScope()
    val focus = LocalFocusManager.current
    val context = LocalContext.current
    val resources = LocalResources.current

    var email by remember { mutableStateOf("") }
    var password by remember { mutableStateOf("") }
    var rememberMe by remember { mutableStateOf(false) }
    var error by remember { mutableStateOf<String?>(null) }
    var info by remember { mutableStateOf<String?>(null) }
    var loading by remember { mutableStateOf(false) }
    var showResetDialog by remember { mutableStateOf(false) }
    var resetEmail by remember { mutableStateOf("") }
    var resetBusy by remember { mutableStateOf(false) }

    LaunchedEffect(Unit) {
        rememberMe = repository.rememberMe()
        if (rememberMe) {
            val remembered = repository.rememberedEmail()
            if (remembered.isNotBlank()) email = remembered
        }
        password = ""
    }

    val webClientId = remember(resources, context.packageName) {
        runCatching {
            resources.getString(
                resources.getIdentifier(
                    "default_web_client_id",
                    "string",
                    context.packageName
                )
            )
        }.getOrDefault("")
    }

    val googleClient = remember(webClientId) {
        if (webClientId.isBlank()) null
        else {
            val gso = GoogleSignInOptions.Builder(GoogleSignInOptions.DEFAULT_SIGN_IN)
                .requestIdToken(webClientId)
                .requestEmail()
                .build()
            GoogleSignIn.getClient(context, gso)
        }
    }

    val googleLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.StartActivityForResult()
    ) { result ->
        if (result.resultCode != Activity.RESULT_OK) {
            loading = false
            return@rememberLauncherForActivityResult
        }
        val task = GoogleSignIn.getSignedInAccountFromIntent(result.data)
        scope.launch {
            try {
                val account = task.getResult(ApiException::class.java)
                val token = account?.idToken
                if (token.isNullOrBlank()) {
                    loading = false
                    error = "Google sign-in failed (no token)."
                    return@launch
                }
                val loginResult = repository.loginWithGoogleIdToken(token, remember = true)
                loading = false
                loginResult
                    .onSuccess {
                        if (repository.session.value.isLoggedIn) onLoggedIn()
                        else error = "Session did not start. Clear app data and retry."
                    }
                    .onFailure { error = it.message ?: "Google sign-in failed" }
            } catch (e: ApiException) {
                loading = false
                Log.w("LoginScreen", "Google ApiException ${e.statusCode}", e)
                error = when (e.statusCode) {
                    10 -> "Google Sign-In not configured (SHA-1). Use email login."
                    12501 -> null
                    else -> "Google sign-in failed (${e.statusCode})."
                }
            } catch (e: Exception) {
                loading = false
                error = e.message ?: "Google sign-in failed"
            }
        }
    }

    fun submitEmail() {
        focus.clearFocus()
        error = null
        info = null
        if (email.isBlank() || password.isBlank()) {
            error = "Enter your email and password."
            return
        }
        loading = true
        scope.launch {
            val result = repository.login(email.trim(), password, rememberMe)
            loading = false
            result
                .onSuccess {
                    if (repository.session.value.isLoggedIn) onLoggedIn()
                    else error = "Session did not start. Clear app data and try again."
                }
                .onFailure { error = it.message ?: "Sign in failed" }
        }
    }

    fun startGoogle() {
        error = null
        info = null
        val client = googleClient ?: run {
            error = "Google Sign-In unavailable."
            return
        }
        loading = true
        client.signOut().addOnCompleteListener {
            googleLauncher.launch(client.signInIntent)
        }
    }

    fun sendReset() {
        val target = resetEmail.trim().ifBlank { email.trim() }
        if (target.isBlank()) {
            error = "Enter your email first."
            return
        }
        resetBusy = true
        error = null
        info = null
        scope.launch {
            val result = repository.sendPasswordReset(target)
            resetBusy = false
            result
                .onSuccess {
                    showResetDialog = false
                    info = "If that account exists, a reset email was sent."
                }
                .onFailure { error = it.message ?: "Could not send reset email" }
        }
    }

    fun fillDemoAndLogin() {
        if (!BuildConfig.DEBUG || !BuildConfig.ALLOW_DEMO_LOGIN) return
        email = DatabaseSeeder.DEMO_EMAIL
        password = DatabaseSeeder.DEMO_PASSWORD
        rememberMe = true
        submitEmail()
    }

    if (showResetDialog) {
        AlertDialog(
            onDismissRequest = { if (!resetBusy) showResetDialog = false },
            title = { Text("Reset password") },
            text = {
                Column {
                    Text("Enter the email for your RJL portal account.")
                    Spacer(Modifier.height(12.dp))
                    TextField(
                        value = resetEmail,
                        onValueChange = { resetEmail = it },
                        singleLine = true,
                        placeholder = { Text("Email") },
                        modifier = Modifier.fillMaxWidth(),
                        enabled = !resetBusy
                    )
                }
            },
            confirmButton = {
                TextButton(onClick = { sendReset() }, enabled = !resetBusy) {
                    Text("Send link", color = MulticomRed)
                }
            },
            dismissButton = {
                TextButton(onClick = { showResetDialog = false }, enabled = !resetBusy) {
                    Text("Cancel")
                }
            }
        )
    }

    Box(modifier = Modifier.fillMaxSize()) {
        // Scene from your design (gate / night) — form area cleaned for live controls
        Image(
            painter = painterResource(R.drawable.login_bg_scene),
            contentDescription = null,
            contentScale = ContentScale.Crop,
            alignment = Alignment.TopCenter,
            modifier = Modifier.fillMaxSize()
        )

        Column(
            modifier = Modifier
                .fillMaxSize()
                .verticalScroll(rememberScrollState())
                .padding(horizontal = 22.dp)
                .padding(top = 32.dp, bottom = 24.dp),
            horizontalAlignment = Alignment.CenterHorizontally
        ) {
            Image(
                painter = painterResource(R.drawable.rjl_logo),
                contentDescription = "RJL Multicom SG-PRO",
                contentScale = ContentScale.Fit,
                modifier = Modifier.size(170.dp)
            )

            Spacer(Modifier.height(8.dp))

            NeonClientPortalLive()

            Spacer(Modifier.height(28.dp))

            Text(
                text = "SIGN IN TO CONTINUE",
                color = Color(0xFF9AA3B2),
                fontSize = 11.sp,
                fontWeight = FontWeight.SemiBold,
                letterSpacing = 2.sp,
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(bottom = 12.dp),
                textAlign = TextAlign.Start
            )

            LiveField(
                value = email,
                onValueChange = { email = it; error = null; info = null },
                label = "Email Address",
                icon = Icons.Default.Email,
                keyboardType = KeyboardType.Email,
                imeAction = ImeAction.Next,
                enabled = !loading
            )

            Spacer(Modifier.height(12.dp))

            LiveField(
                value = password,
                onValueChange = { password = it; error = null; info = null },
                label = "Password",
                icon = Icons.Default.Lock,
                keyboardType = KeyboardType.Password,
                imeAction = ImeAction.Done,
                isPassword = true,
                enabled = !loading,
                onDone = { submitEmail() }
            )

            Spacer(Modifier.height(4.dp))

            Row(
                verticalAlignment = Alignment.CenterVertically,
                modifier = Modifier.fillMaxWidth()
            ) {
                Checkbox(
                    checked = rememberMe,
                    onCheckedChange = { rememberMe = it },
                    enabled = !loading,
                    colors = CheckboxDefaults.colors(
                        checkedColor = MulticomRed,
                        uncheckedColor = Color(0xFF64748B),
                        checkmarkColor = Color.White
                    )
                )
                Text(
                    text = "Remember me on this device",
                    color = Color(0xFFCBD5E1),
                    fontSize = 13.sp,
                    modifier = Modifier
                        .weight(1f)
                        .clickable(enabled = !loading) { rememberMe = !rememberMe }
                )
                Text(
                    text = "Forgot password?",
                    color = MulticomRed,
                    fontSize = 13.sp,
                    fontWeight = FontWeight.SemiBold,
                    modifier = Modifier
                        .clickable(enabled = !loading) {
                            resetEmail = email
                            showResetDialog = true
                        }
                        .padding(vertical = 8.dp)
                )
            }

            if (error != null) {
                Text(
                    text = error!!,
                    color = Color(0xFFFF6B6B),
                    fontSize = 13.sp,
                    fontWeight = FontWeight.SemiBold,
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(bottom = 6.dp)
                )
            }
            if (info != null) {
                Text(
                    text = info!!,
                    color = Color(0xFF86EFAC),
                    fontSize = 13.sp,
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(bottom = 6.dp)
                )
            }

            Spacer(Modifier.height(4.dp))

            Button(
                onClick = { submitEmail() },
                enabled = !loading,
                modifier = Modifier
                    .fillMaxWidth()
                    .height(54.dp),
                shape = RoundedCornerShape(12.dp),
                colors = ButtonDefaults.buttonColors(
                    containerColor = MulticomRed,
                    contentColor = Color.White,
                    disabledContainerColor = MulticomRed.copy(alpha = 0.55f)
                )
            ) {
                if (loading) {
                    CircularProgressIndicator(
                        color = Color.White,
                        strokeWidth = 2.dp,
                        modifier = Modifier.size(22.dp)
                    )
                } else {
                    Text(
                        text = "SIGN IN",
                        fontWeight = FontWeight.Bold,
                        letterSpacing = 1.5.sp,
                        fontSize = 15.sp
                    )
                }
            }

            Spacer(Modifier.height(18.dp))

            Row(
                verticalAlignment = Alignment.CenterVertically,
                modifier = Modifier.fillMaxWidth()
            ) {
                HorizontalDivider(modifier = Modifier.weight(1f), color = Color(0xFF2A3140))
                Text(
                    text = "  OR  ",
                    color = Color(0xFF64748B),
                    fontSize = 12.sp,
                    fontWeight = FontWeight.SemiBold
                )
                HorizontalDivider(modifier = Modifier.weight(1f), color = Color(0xFF2A3140))
            }

            Spacer(Modifier.height(14.dp))

            OutlinedButton(
                onClick = { startGoogle() },
                enabled = !loading && googleClient != null,
                modifier = Modifier
                    .fillMaxWidth()
                    .height(52.dp),
                shape = RoundedCornerShape(12.dp),
                border = BorderStroke(1.5.dp, MulticomRed),
                colors = ButtonDefaults.outlinedButtonColors(contentColor = Color.White)
            ) {
                Text(
                    text = "G  Continue with Google",
                    fontWeight = FontWeight.SemiBold,
                    fontSize = 14.sp
                )
            }

            Spacer(Modifier.height(28.dp))

            FeatureStrip()

            Spacer(Modifier.height(20.dp))

            Text(
                text = "Need help? Contact RJL Commercial for portal access.",
                color = Color(0xFF64748B),
                fontSize = 11.sp,
                textAlign = TextAlign.Center,
                modifier = Modifier.fillMaxWidth()
            )

            if (BuildConfig.DEBUG && BuildConfig.ALLOW_DEMO_LOGIN) {
                Spacer(Modifier.height(12.dp))
                OutlinedButton(
                    onClick = { fillDemoAndLogin() },
                    enabled = !loading,
                    modifier = Modifier.fillMaxWidth(),
                    shape = RoundedCornerShape(12.dp),
                    border = BorderStroke(1.dp, Color(0xFF475569)),
                    colors = ButtonDefaults.outlinedButtonColors(contentColor = Color(0xFF94A3B8))
                ) {
                    Text("Debug: sign in as installer demo", fontSize = 13.sp)
                }
            }

            Spacer(Modifier.height(8.dp))
            Text(
                text = "© RJL Multicom SG‑PRO  ·  Access Control",
                color = Color(0xFF3F4654),
                fontSize = 10.sp,
                textAlign = TextAlign.Center,
                modifier = Modifier.fillMaxWidth()
            )
        }
    }
}

/** Live neon CLIENT PORTAL — pulses like the design. */
@Composable
private fun NeonClientPortalLive() {
    val flash = rememberInfiniteTransition(label = "neonLive")
    val pulse by flash.animateFloat(
        initialValue = 0.5f,
        targetValue = 1f,
        animationSpec = infiniteRepeatable(
            animation = tween(480, easing = LinearEasing),
            repeatMode = RepeatMode.Reverse
        ),
        label = "pulse"
    )
    val glow by flash.animateFloat(
        initialValue = 16f,
        targetValue = 52f,
        animationSpec = infiniteRepeatable(
            animation = tween(560, easing = LinearEasing),
            repeatMode = RepeatMode.Reverse
        ),
        label = "glow"
    )
    val a = pulse.coerceIn(0f, 1f)
    val style = TextStyle(
        fontSize = 28.sp,
        fontWeight = FontWeight.Black,
        letterSpacing = 2.5.sp,
        textAlign = TextAlign.Center
    )

    Box(
        contentAlignment = Alignment.Center,
        modifier = Modifier
            .fillMaxWidth()
            .clip(RoundedCornerShape(40.dp))
            .background(
                Brush.horizontalGradient(
                    listOf(
                        NeonBlueDeep.copy(alpha = 0.28f * a),
                        NeonBlue.copy(alpha = 0.42f * a),
                        NeonBlueDeep.copy(alpha = 0.28f * a)
                    )
                )
            )
            .border(
                width = 2.5.dp,
                brush = Brush.horizontalGradient(
                    listOf(
                        NeonBlueBright.copy(alpha = 0.4f * a),
                        NeonBlueBright.copy(alpha = a),
                        NeonBlueBright.copy(alpha = 0.4f * a)
                    )
                ),
                shape = RoundedCornerShape(40.dp)
            )
            .padding(horizontal = 18.dp, vertical = 12.dp)
    ) {
        Text(
            text = "CLIENT PORTAL",
            style = style.copy(
                color = NeonBlueDeep.copy(alpha = a * 0.6f),
                shadow = Shadow(
                    color = NeonBlueDeep.copy(alpha = a * 0.95f),
                    offset = Offset.Zero,
                    blurRadius = glow * 1.7f
                )
            ),
            modifier = Modifier.fillMaxWidth(),
            textAlign = TextAlign.Center
        )
        Text(
            text = "CLIENT PORTAL",
            style = style.copy(
                color = NeonBlue.copy(alpha = a * 0.95f),
                shadow = Shadow(
                    color = NeonBlue.copy(alpha = a),
                    offset = Offset.Zero,
                    blurRadius = glow
                )
            ),
            modifier = Modifier.fillMaxWidth(),
            textAlign = TextAlign.Center
        )
        Text(
            text = "CLIENT PORTAL",
            style = style.copy(
                color = NeonBlueBright.copy(alpha = a),
                shadow = Shadow(
                    color = NeonBlueBright.copy(alpha = a * 0.95f),
                    offset = Offset.Zero,
                    blurRadius = glow * 0.4f
                )
            ),
            modifier = Modifier.fillMaxWidth(),
            textAlign = TextAlign.Center
        )
    }
}

@Composable
private fun LiveField(
    value: String,
    onValueChange: (String) -> Unit,
    label: String,
    icon: ImageVector,
    keyboardType: KeyboardType,
    imeAction: ImeAction,
    isPassword: Boolean = false,
    enabled: Boolean = true,
    onDone: (() -> Unit)? = null
) {
    TextField(
        value = value,
        onValueChange = onValueChange,
        enabled = enabled,
        singleLine = true,
        visualTransformation = if (isPassword) {
            PasswordVisualTransformation()
        } else {
            VisualTransformation.None
        },
        leadingIcon = {
            Icon(
                imageVector = icon,
                contentDescription = null,
                tint = Color(0xFF94A3B8),
                modifier = Modifier.size(20.dp)
            )
        },
        placeholder = {
            Text(label, color = Color(0xFF64748B), fontSize = 14.sp)
        },
        modifier = Modifier
            .fillMaxWidth()
            .clip(RoundedCornerShape(14.dp))
            .border(1.dp, Color(0xFF2A3140), RoundedCornerShape(14.dp)),
        colors = TextFieldDefaults.colors(
            focusedTextColor = Color.White,
            unfocusedTextColor = Color.White,
            disabledTextColor = Color.White.copy(alpha = 0.6f),
            focusedContainerColor = Color(0xF2181D26),
            unfocusedContainerColor = Color(0xF2181D26),
            disabledContainerColor = Color(0xF2181D26),
            cursorColor = MulticomRed,
            focusedIndicatorColor = Color.Transparent,
            unfocusedIndicatorColor = Color.Transparent,
            disabledIndicatorColor = Color.Transparent
        ),
        keyboardOptions = KeyboardOptions(
            keyboardType = keyboardType,
            imeAction = imeAction
        ),
        keyboardActions = KeyboardActions(onDone = { onDone?.invoke() })
    )
}

@Composable
private fun FeatureStrip() {
    Row(
        modifier = Modifier.fillMaxWidth(),
        horizontalArrangement = Arrangement.SpaceBetween
    ) {
        FeatureItem(Icons.Default.Security, "SECURE\nACCESS", "Enterprise-grade\nsecurity", Modifier.weight(1f))
        FeatureItem(Icons.Default.Schedule, "REAL-TIME\nUPDATES", "Live project &\nservice updates", Modifier.weight(1f))
        FeatureItem(Icons.Default.Monitor, "SYSTEM\nMONITORING", "Gates & access\n24/7", Modifier.weight(1f))
        FeatureItem(Icons.Default.Groups, "TEAM\nCOLLABORATION", "Work together\nacross devices", Modifier.weight(1f))
    }
}

@Composable
private fun FeatureItem(
    icon: ImageVector,
    title: String,
    subtitle: String,
    modifier: Modifier = Modifier
) {
    Column(
        horizontalAlignment = Alignment.CenterHorizontally,
        modifier = modifier.padding(horizontal = 2.dp)
    ) {
        Icon(icon, null, tint = MulticomRed, modifier = Modifier.size(22.dp))
        Spacer(Modifier.height(6.dp))
        Text(
            text = title,
            color = Color(0xFFE2E8F0),
            fontSize = 9.sp,
            fontWeight = FontWeight.Bold,
            textAlign = TextAlign.Center,
            lineHeight = 11.sp
        )
        Spacer(Modifier.height(3.dp))
        Text(
            text = subtitle,
            color = Color(0xFF64748B),
            fontSize = 8.sp,
            textAlign = TextAlign.Center,
            lineHeight = 10.sp
        )
    }
}
