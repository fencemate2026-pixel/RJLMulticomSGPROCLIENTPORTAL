        buildConfigField("String", "DEMO_PORTAL_URL", "\"http://100.103.206.69:5000\"")
        buildConfigField("String", "DEMO_GSM_NUMBER", "\"02886390693\"")
        buildConfigField("boolean", "MAPS_CONFIGURED", mapsApiKey.isNotBlank().toString())
