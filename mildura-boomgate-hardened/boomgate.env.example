# Install to /etc/boomgate.env  (chmod 600, root:root)
# Referenced by systemd EnvironmentFile=
ADMIN_PIN=REPLACE_WITH_6_DIGIT_ADMIN_PIN
FLASK_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_HEX
GPIOZERO_PIN_FACTORY=lgpio
PYTHONUNBUFFERED=1
# Set to 1 only if physical keypad PINs decode wrong after upgrade
# WIEGAND_INVERT_BITS=0
# PULSE_SECONDS=1.5
