/**
 * RJL Multicom SG-PRO â€” Production controller
 * ESP32-S3 + Waveshare SIM7600G-H 4G DTU
 *
 * FINAL BEHAVIOUR
 * â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
 * Portal add/delete â†’ Firebase whitelistVersion++
 * ESP32 polls ~60s â†’ validate temp â†’ atomic activate local list
 * Incoming call â†’ local list only â†’ AT+CHUP â†’ 3s relay if authorised
 * Welcome SMS â†’ gsmSmsQueue jobs PENDINGâ†’SENDINGâ†’SENT|FAILED, ack by jobId
 *
 * Secrets: provision once via Serial "PROVISION <secret>" â†’ Preferences NVS
 * Never commit live DEVICE_SECRET to git.
 *
 * Libraries: ArduinoJson, Preferences, WiFi, HTTPClient, mbedTLS (built-in ESP32)
 */

#include <Arduino.h>
#include <WiFi.h>
#include <HTTPClient.h>
#include <WiFiClientSecure.h>
#include <Preferences.h>
#include <ArduinoJson.h>
#include <mbedtls/md.h>
#include <esp_random.h>
#include <time.h>

// â”€â”€ Pins (ESP32-S3 Screw Terminal Board) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Silkscreen usually says IO17 / IO18 / IO5 (or G17 / G18 / G5) â€” not "GPIO18".
//
//   SIM7600G-H DTU TXD  â†’  board IO18  (ESP32 RX  = MODEM_RX_PIN)
//   SIM7600G-H DTU RXD  â†’  board IO17  (ESP32 TX  = MODEM_TX_PIN)
//   SIM7600G-H DTU GND  â†’  board GND
//   Relay IN            â†’  board IO5
//   Relay GND           â†’  board GND
//
// Power DTU from 12V (7â€“36V), NOT from the ESP32 3V3/5V.
// If your terminal strip has no IO17/IO18, pick two free UARTable IOs
// (e.g. IO15/IO16) and change the three numbers below to match the labels.
constexpr uint8_t MODEM_RX_PIN = 18;  // ESP32 receives from modem TXD
constexpr uint8_t MODEM_TX_PIN = 17;  // ESP32 sends to modem RXD
constexpr uint8_t RELAY_PIN = 5;
constexpr bool RELAY_ACTIVE_LOW = true;

constexpr uint32_t USB_BAUD = 115200;
constexpr uint32_t MODEM_BAUD = 115200;
constexpr uint32_t RELAY_PULSE_MS = 3000;
constexpr uint32_t CALL_LOCKOUT_MS = 10000;
constexpr uint32_t HIDDEN_CALL_TIMEOUT_MS = 3000;
constexpr uint32_t WHITELIST_POLL_MS = 60UL * 1000UL;
constexpr uint32_t HEARTBEAT_MS = 5UL * 60UL * 1000UL;
constexpr uint32_t SMS_COOLDOWN_MS = 2000;

